<% layout('layouts/boilerplate') %>

    <head>
        <!-- Add the Starability Slot CSS -->
        <link rel="stylesheet" href="/css/rating.css">
    </head>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h3>
                    <%= listing.title %>
                </h3>
            </div>
            <div class="card col-6 offset-3 show-card listing-card">
                <!-- Handle missing image gracefully -->
                <img src="<%= listing.image ? listing.image.url : '/images/default.jpg' %>"
                    class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <p class="card-text">
                        <b></b><br>
                    </p>
                    <!-- Handle missing owner gracefully -->
                    <p><i>Owned by: <%= listing.owner ? listing.owner.username : 'Unknown' %></i></p>
                    <p>
                        <%= listing.description %>
                    </p>
                    <p> &#8377;<%= listing.price.toLocaleString("en-IN") %>
                    </p>
                    <p>
                        <%= listing.location %>
                    </p>
                    <p>
                        <%= listing.country %>
                    </p>
                </div>
            </div>
            <br>
        </div>

        <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark offset-5">Delete</button>
                </form>
            </div>
            <% } %>

                <div class="col-8 offset-3 mb-3">
                    <hr>
                    <% if (currUser) { %>
                        <h4>Leave a Review</h4>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate
                            class="needs-validation">
                            <div class="mb-3 mt-3">
                                <label for="rating" class="form-label">Rating</label>
                                <fieldset class="starability-slot">
                                    <!-- Default to 1 star -->
                                    <input type="radio" id="rate5" name="review[rating]" value="5" />
                                    <label for="rate5" title="5 stars">☆</label>

                                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                                    <label for="rate4" title="4 stars">☆</label>

                                    <input type="radio" id="rate3" name="review[rating]" value="3" />
                                    <label for="rate3" title="3 stars">☆</label>

                                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                                    <label for="rate2" title="2 stars">☆</label>

                                    <!-- Default to 1 star by setting the 'checked' attribute -->
                                    <input type="radio" id="rate1" name="review[rating]" value="1" checked />
                                    <label for="rate1" title="1 star">☆</label>
                                </fieldset>
                            </div>
                            <div class="mb-3 mt-3">
                                <label for="comment" class="form-label">Comments</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">Please add some comments for the review</div>
                            </div>
                            <button class="btn btn-outline-dark">Submit</button>
                        </form>
                        <hr>
                        <% } %>

                            <p><b>All Reviews</b></p>
                            <div class="container">
                                <div class="row">
                                    <% listing.reviews.forEach((review, index)=> { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="card">
                                                <div class="card-body">
                                                    <h5 class="card-title ms-1">
                                                        <%= review.author ? review.author.username : 'Anonymous' %>
                                                    </h5>
                                                    <p class="card-text ms-2">
                                                        <%= review.comment %>
                                                    </p>
                                                    <p class="card-text ms-2">
                                                        <!-- Displaying the review's rating using Starability Slot -->
                                                    <fieldset class="starability-slot">
                                                        <!-- Stars are disabled and reflect the rating -->
                                                        <input type="radio" id="rate<%= index %>5"
                                                            name="rating<%= index %>" value="5" <% if (review.rating==5)
                                                            { %> checked <% } %> disabled />
                                                            <label for="rate<%= index %>5" title="5 stars">☆</label>

                                                            <input type="radio" id="rate<%= index %>4"
                                                                name="rating<%= index %>" value="4" <% if
                                                                (review.rating==4) { %> checked <% } %> disabled />
                                                                <label for="rate<%= index %>4" title="4 stars">☆</label>

                                                                <input type="radio" id="rate<%= index %>3"
                                                                    name="rating<%= index %>" value="3" <% if
                                                                    (review.rating==3) { %> checked <% } %> disabled />
                                                                    <label for="rate<%= index %>3"
                                                                        title="3 stars">☆</label>

                                                                    <input type="radio" id="rate<%= index %>2"
                                                                        name="rating<%= index %>" value="2" <% if
                                                                        (review.rating==2) { %> checked <% } %> disabled
                                                                        />
                                                                        <label for="rate<%= index %>2"
                                                                            title="2 stars">☆</label>

                                                                        <input type="radio" id="rate<%= index %>1"
                                                                            name="rating<%= index %>" value="1" <% if
                                                                            (review.rating==1) { %> checked <% } %>
                                                                            disabled />
                                                                            <label for="rate<%= index %>1"
                                                                                title="1 star">☆</label>
                                                    </fieldset>
                                                    </p>
                                                </div>
                                                <% if (currUser && review.author &&
                                                    currUser._id.equals(review.author._id)) { %>
                                                    <form method="POST"
                                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                        <button class="btn btn-sm btn-dark ms-2 mt-1">Delete</button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                            </div>
                </div>
    </body>